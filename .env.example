# Leave CITERX_LLM_BASE_URL empty to run in extractive mode (no LLM needed).

# Local, fully offline with Ollama:
CITERX_LLM_BASE_URL=http://localhost:11434/v1
CITERX_LLM_MODEL=qwen3:latest
CITERX_LLM_API_KEY=ollama

# Or a hosted OpenAI-compatible API, e.g. Groq:
# CITERX_LLM_BASE_URL=https://api.groq.com/openai/v1
# CITERX_LLM_MODEL=llama-3.3-70b-versatile
# CITERX_LLM_API_KEY=gsk_...

# Models: auto | neural | hashing   and   auto | cross-encoder | coverage | none
CITERX_EMBEDDER=auto
CITERX_RERANKER=auto
